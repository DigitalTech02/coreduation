OPENAI_API_KEY=your-openai-api-key-here
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# TTS provider: "openai" or "elevenlabs" (default: openai)
TTS_PROVIDER=openai

# OpenAI TTS settings
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# ElevenLabs TTS settings
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_v3

# --- Retention & Production Upgrades ---

# Retention mode: auto-inject visual beats in dormant scenes
RETENTION_MODE=true
MAX_IDLE_VISUAL_SECONDS=3

# Camera motion (focus_camera / reset_camera)
ENABLE_CAMERA_MOTION=true
CAMERA_DEFAULT_ZOOM=1.2
CAMERA_MAX_ZOOM=1.35

# Progress UI (show_progress / update_progress)
ENABLE_PROGRESS_UI=true

# Subtitles
ENABLE_SUBTITLES=true
SUBTITLE_MODE=phrase
SUBTITLE_POSITION=bottom
SUBTITLE_MAX_WORDS=7

# Sound effects (requires files in assets/sfx/)
ENABLE_SFX=true
SFX_VOLUME_DB=-16

# Background music (requires files in assets/music/)
ENABLE_BACKGROUND_MUSIC=true
MUSIC_VOLUME_DB=-28
