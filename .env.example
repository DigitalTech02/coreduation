OPENAI_API_KEY=your-openai-api-key-here
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# TTS provider: "openai" or "elevenlabs" (default: openai)
TTS_PROVIDER=openai

# OpenAI TTS settings
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# ElevenLabs TTS settings
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_v3

# --- Retention & Production Upgrades ---

# Retention mode: auto-inject visual beats in dormant scenes
RETENTION_MODE=true
MAX_IDLE_VISUAL_SECONDS=3

# Camera motion (focus_camera / reset_camera)
ENABLE_CAMERA_MOTION=true
CAMERA_DEFAULT_ZOOM=1.2
CAMERA_MAX_ZOOM=1.35

# Progress UI (show_progress / update_progress)
ENABLE_PROGRESS_UI=true

# Subtitles
ENABLE_SUBTITLES=true
SUBTITLE_MODE=phrase
SUBTITLE_POSITION=bottom
SUBTITLE_MAX_WORDS=7

# Sound effects (requires files in assets/sfx/)
ENABLE_SFX=true
SFX_VOLUME_DB=-16

# Background music (requires files in assets/music/)
ENABLE_BACKGROUND_MUSIC=true
MUSIC_VOLUME_DB=-28

# --- Engagement Upgrade ---

# Vision QA loop (uses GPT-4o, ~$0.01/frame, ~$0.10-0.30/video)
ENABLE_VISION_QA=false
VISION_QA_SAMPLE_SECONDS=8
VISION_QA_MODEL=gpt-4o

# Cache layer (TTS audio + LLM scripts) — speeds up iteration
ENABLE_CACHE=true
CACHE_DIR=.cache

# Branding (intro/outro/watermark)
ENABLE_BRANDING=true
CHANNEL_NAME=CoreDuation
CHANNEL_TAGLINE=Engineering, explained.
ENABLE_INTRO_CARD=true
ENABLE_OUTRO_CARD=true
ENABLE_WATERMARK=true

# Themed backgrounds (per-category palette + animated gradient)
ENABLE_THEMED_BACKGROUNDS=true
ENABLE_GRADIENT_BACKGROUND=true

# Whisper kinetic typography (requires `pip install openai-whisper`; first
# run downloads the model)
ENABLE_KINETIC_SUBTITLES=false
WHISPER_MODEL=base

# Multi-voice TTS (per-scene mood)
ENABLE_MULTI_VOICE=true
DEFAULT_VOICE_MOOD=narrator

# Mood-matched background music (per-scene swap based on tags)
ENABLE_MOOD_MUSIC=true

# Easing & camera (parallax on title / topology scenes)
ENABLE_PARALLAX=true

# Pattern-interrupt effects (flash_cut, zoom_punch, glitch)
ENABLE_PATTERN_INTERRUPTS=true
PATTERN_INTERRUPT_INTERVAL=35

# Remotion chrome layer (intro/outro/lower-thirds — requires `cd chrome && npm install`)
ENABLE_REMOTION_CHROME=false
REMOTION_INTRO_DURATION=3.0
REMOTION_OUTRO_DURATION=4.0

# AI-generated B-roll (multi-provider + rembg + Ken Burns)
ENABLE_AI_BROLL=false

# Image generation provider.  Pipeline falls back to OpenAI DALL-E if the
# selected provider's API key is missing or its SDK is not installed.
#   "fal"       — fal.ai FLUX (~$0.003/image schnell, default)
#   "openai"    — DALL-E 3 (~$0.04/image)
#   "recraft"   — Recraft V3 (~$0.04/image, best vector/illustration style)
#   "replicate" — Replicate (~$0.003-0.05, large model catalog)
BROLL_IMAGE_PROVIDER=fal

# --- fal.ai (provider=fal) ---
# Get a key at https://fal.ai/dashboard/keys.  pip install fal-client.
FAL_KEY=
#   fal-ai/flux/schnell  — cheapest+fastest (~$0.003, ~2s)
#   fal-ai/flux/dev      — higher quality (~$0.025, ~5s)
#   fal-ai/flux-pro      — best quality (~$0.05)
FAL_IMAGE_MODEL=fal-ai/flux/schnell

# --- Recraft V3 (provider=recraft) ---
# Get a key at https://www.recraft.ai/profile/api.  No SDK required.
RECRAFT_API_TOKEN=
#   recraftv3   — $0.04/image
#   recraft-20b — $0.022/image (cheaper, slightly less polished)
RECRAFT_IMAGE_MODEL=recraftv3
# Style preset:
#   digital_illustration   — vibrant cartoon panels (default)
#   vector_illustration    — flat vector / icon style
#   realistic_image        — photorealistic
# Sub-styles via slash, e.g. "digital_illustration/3d".
RECRAFT_STYLE=digital_illustration

# --- Replicate (provider=replicate) ---
# Get a key at https://replicate.com/account/api-tokens.  pip install replicate.
REPLICATE_API_TOKEN=
#   black-forest-labs/flux-schnell    — ~$0.003/image, fastest (default)
#   black-forest-labs/flux-dev        — ~$0.025/image
#   black-forest-labs/flux-1.1-pro    — ~$0.04/image, best FLUX
#   stability-ai/stable-diffusion-3.5-large — SD 3.5 alternative
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell

# --- OpenAI DALL-E (provider=openai, also the universal fallback) ---
BROLL_IMAGE_MODEL=dall-e-3

# 3D topology scenes
ENABLE_3D_TOPOLOGY=false

# YouTube auto-upload (requires OAuth client_secret.json + token cached at ./youtube_token.json)
ENABLE_YOUTUBE_UPLOAD=false
YOUTUBE_PRIVACY_STATUS=private  # private | unlisted | public
YOUTUBE_CATEGORY_ID=27          # 27 = Education
YOUTUBE_CLIENT_SECRET=client_secret.json
YOUTUBE_TOKEN_FILE=youtube_token.json

# Thumbnail generation (Pillow). Set to true to also try AI background via DALL-E.
ENABLE_THUMBNAIL_GEN=true
THUMBNAIL_USE_AI_BG=false
# Optional path override for the title font (defaults to system bold sans).
# THUMBNAIL_FONT=C:/Windows/Fonts/arialbd.ttf

# Multi-language dubs (comma-separated ISO codes, e.g. "es,hi,fr")
ENABLE_DUBS=false
DUB_LANGUAGES=
OPENAI_TRANSLATION_MODEL=gpt-4o
